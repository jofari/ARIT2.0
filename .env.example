# ARIT V1 — variables d'environnement. Copier vers .env ; .env n'est JAMAIS committe.
# Les noms ci-dessous sont EXACTEMENT ceux que lisent les services (ne pas renommer).

# Finnhub — calendrier economique (services/macro_state.py, docs/06)
FINNHUB_KEY=

# Discord (services/discord_bot.py + watchdog, docs/08)
DISCORD_BOT_TOKEN=
